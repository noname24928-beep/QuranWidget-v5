<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#0B3D2E</item>
        <item name="android:colorPrimaryDark">#072A20</item>
        <item name="android:colorAccent">#0F8B6B</item>
        <item name="android:colorControlActivated">#0F8B6B</item>
        <item name="android:statusBarColor">#0B3D2E</item>
        <item name="android:navigationBarColor">#072A20</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:textColorPrimary">#1F2A24</item>
        <item name="android:buttonStyle">@style/AppButton</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>

    <style name="AppButton" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/btn_bg</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="AppDialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#0F8B6B</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">#1F2A24</item>
        <item name="android:buttonBarButtonStyle">@style/AppDialogButton</item>
    </style>

    <style name="AppDialogButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">#0B6B52</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
